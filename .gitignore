!datasets/**/*.xlsx

# Include the "functions" folder and its contents
!functions/
!functions/*.R

# Include the "questionnaire_data" folder and its contents
!questionnaire_data/
!questionnaire_data/*.pdf
!questionnaire_data/*.xlsx

# Dynamic-validation: only the model folders and the results folder are
# tracked in git (and therefore uploaded to GitHub). The supporting docs
# (.md files) and the per-analysis scripts in analysis/ stay on disk
# locally but are NOT tracked - the canonical workflow for the manuscript
# is code_dynamic_validation.{Rmd,R,pdf} at the repo root.
!dynamic_validation/

# Local-only files inside dynamic_validation/ (not tracked, not pushed)
dynamic_validation/*.md
dynamic_validation/analysis/
dynamic_validation/*.zip

# Superseded May-2026 runtime exports (replaced by callgraph_csv/)
dynamic_validation/ORCHIDEE/
dynamic_validation/PCR/

# Knit-ed / rendered artefacts (local-only too)
dynamic_validation/*.html
dynamic_validation/*_files/
dynamic_validation/*_cache/

.Rproj.user
